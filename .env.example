# Copy to `.env` and edit:  cp .env.example .env
# `.env` is gitignored (may hold secrets). `make run` loads it automatically.
# The app reads these as plain environment variables.

# --- Bitcoin Core RPC endpoint (http:// local node, or https:// provider) ---
BTC_RPC_URL=http://127.0.0.1:18443

# --- Auth: pick ONE block (or leave all blank for token-in-URL providers) ---
# Cookie (local node) — use an ABSOLUTE path (the app does not expand `~`):
BTC_RPC_COOKIE_FILE=/home/you/.bitcoin/regtest/.cookie
# User/pass:
# BTC_RPC_USER=user
# BTC_RPC_PASS=pass
# API-key header (comma-separate multiple):
# BTC_RPC_HEADERS=X-Api-Key: your_key

# --- HTTP + tuning (optional; defaults shown) ---
HTTP_BIND=127.0.0.1:8080
POLL_INTERVAL_MS=2000
RPC_TIMEOUT_SECS=30
RUST_LOG=info
