# Copy to `.env` and edit:  cp .env.example .env
# `.env` is gitignored (may hold secrets). `make run` loads it automatically.
# The app reads these as plain environment variables.

# --- Bitcoin Core RPC endpoint (http:// local node, or https:// provider) ---
BTC_RPC_URL=http://127.0.0.1:18443

# --- Auth: pick ONE block (or leave all blank for token-in-URL providers) ---
# Cookie (local node) — use an ABSOLUTE path (the app does not expand `~`):
BTC_RPC_COOKIE_FILE=/home/you/.bitcoin/regtest/.cookie
# User/pass:
# BTC_RPC_USER=user
# BTC_RPC_PASS=pass
# API-key header (comma-separate multiple):
# BTC_RPC_HEADERS=X-Api-Key: your_key

# --- HTTP + tuning (optional; defaults shown) ---
HTTP_BIND=127.0.0.1:8080
POLL_INTERVAL_MS=2000
RPC_TIMEOUT_SECS=30

# --- Logging ---
# Base level. Useful targets you can dial independently:
#   bitcoincore_rpc=debug  -> one line per RPC call (method + args); =trace adds full responses
#   tower_http::trace=warn -> silence the per-request HTTP access log (e.g. /health polls)
RUST_LOG=info
# Log one INFO line per sync tick (adds/removes/size/tip). Off by default; handy
# when validating a new node/provider. Accepts true/false/1/0/yes/no.
SYNC_LOG_VERBOSE=false
# Seconds between steady-state liveness "heartbeat" logs (0 disables). Also drives
# the throttled "sync in progress" line during a long fetch against a slow provider.
HEARTBEAT_SECS=30
