# Copy to `.env` and edit:  cp .env.example .env
# `.env` is gitignored (may hold secrets). `make run` loads it automatically.
# The app reads these as plain environment variables.

# --- Bitcoin Core RPC endpoint (http:// local node, or https:// provider) ---
BTC_RPC_URL=http://127.0.0.1:18443

# --- Auth: pick ONE block (or leave all blank for token-in-URL providers) ---
# Cookie (local node) — use an ABSOLUTE path (the app does not expand `~`):
BTC_RPC_COOKIE_FILE=/home/you/.bitcoin/regtest/.cookie
# User/pass:
# BTC_RPC_USER=user
# BTC_RPC_PASS=pass

# --- HTTP + tuning (optional; defaults shown) ---
HTTP_BIND=127.0.0.1:8080
POLL_INTERVAL_MS=2000
RPC_TIMEOUT_SECS=30
# Max concurrent getmempoolentry calls per tick. Bound by node rpcthreads
# (default 4) / rpcworkqueue (default 16); set rpcthreads>=FETCH_CONCURRENCY for full benefit.
FETCH_CONCURRENCY=10
# Node zmqpubhashblock endpoint for immediate recompute on new blocks (needs
# `zmqpubhashblock=tcp://...` in bitcoin.conf). Unset = polling only.
# BTC_ZMQ_BLOCK=tcp://127.0.0.1:28332
# Max fetch time per tick before bailing and marking caught_up=false. Default: 2 x POLL_INTERVAL_MS.
# TICK_BUDGET_MS=4000

# --- Logging ---
# Base level. The sync loop is quiet when healthy and surfaces RPC errors at warn.
#   tower_http::trace=warn -> silence the per-request HTTP access log (e.g. /health polls)
RUST_LOG=info
